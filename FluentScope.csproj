<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net8.0-windows</TargetFramework>
    <UseWPF>true</UseWPF>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
    <RootNamespace>FluentScope</RootNamespace>
    <AssemblyName>FluentScope</AssemblyName>
    <ApplicationIcon>icon.ico</ApplicationIcon>
    <Product>FluentScope</Product>
    <Company>Francesco Ferrara</Company>
    <Copyright>© Francesco Ferrara — www.elenafrancesco.org</Copyright>
    <!-- Manual X.Y.Z version (Z = bugfix/tweak, Y = new feature, X = upheaval).
         Bumped only on releases; docs/refactor/build never change it. -->
    <Version>1.0.0</Version>
    <Description>Shows at which speed and USB standard the machine's USB devices are connected (snapshot + live mode).</Description>
  </PropertyGroup>

  <ItemGroup>
    <EmbeddedResource Include="Data\usb.ids" />
  </ItemGroup>

</Project>
